# Neon Postgres (tambahkan lewat Vercel > Storage > Neon, otomatis mengisi DATABASE_URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# String acak minimal 32 karakter, contoh: openssl rand -hex 32
SESSION_SECRET=

# Gemini API key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model default untuk chat publik dan fitur PRO.
# Model penilaian jawaban terbuka tetap dikunci ke Gemma 4 31B IT.
GEMINI_MODEL=gemma-4-31b-it

