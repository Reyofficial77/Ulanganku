# Neon Postgres (tambahkan lewat Vercel > Storage > Neon, otomatis mengisi DATABASE_URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# String acak minimal 32 karakter, contoh: openssl rand -hex 32
SESSION_SECRET=

# Google Gemini API (buat key di https://aistudio.google.com/apikey, lalu atur di Vercel)
GEMINI_API_KEY=

# Opsional: ID model default untuk chatbot (model saat ini dapat diubah di api/index.ts)
GEMINI_MODEL=gemini-3.8-flash

# PRO: nomor WhatsApp admin untuk konfirmasi pembayaran, format internasional tanpa + (contoh 62812xxxxxxx)
ADMIN_WHATSAPP=
# Opsional: harga PRO dalam rupiah, ditampilkan di halaman pembayaran. Kosongkan jika belum ditetapkan.
PRO_PRICE_IDR=
