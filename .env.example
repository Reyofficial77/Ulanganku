# Neon Postgres (tambahkan lewat Vercel > Storage > Neon, otomatis mengisi DATABASE_URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# String acak minimal 32 karakter, contoh: openssl rand -hex 32
SESSION_SECRET=

# Ollama Cloud API (buat key di https://ollama.com/settings/keys, lalu atur di Vercel)
OLLAMA_API_KEY=

# Opsional: ID model default untuk chatbot dan fitur PRO.
OLLAMA_MODEL=gemma4:31b

# Opsional: daftar fallback dipisahkan koma bila katalog Ollama Cloud tidak tersedia.
# Bila katalog API berhasil, aplikasi tetap memakai daftar model aktual yang dikembalikan API.
OLLAMA_MODELS=gemma4:31b
